{
  "manifest_version": 2,
  "version": "1.1.1",
  "name": "定時提醒",
  "description": "按 cron 定時喚醒麥麥在聊天中提醒，可一次或重複；麥麥也會順手記下群友之後的安排，到時關心一下",
  "author": {
    "name": "Luca Chen",
    "url": "https://github.com/Mai-with-u/MaiBot"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/Mai-with-u/MaiBot"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "maisaka.proactive.trigger",
    "send.text",
    "chat.get_all_streams",
    "component.enable",
    "component.disable"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  },
  "id": "luca.reminder"
}
